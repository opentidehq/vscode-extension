{
  "$comment": "The core's contributions. Each feature adds contrib/<feature>.json; scripts/manifest.mjs merges them into package.json.",
  "activationEvents": [
    "workspaceContains:.opentide/**",
    "workspaceContains:objects/**",
    "onLanguage:opentide-yaml",
    "onLanguage:opentide-config",
    "onLanguage:kql",
    "onLanguage:spl",
    "onLanguage:esql",
    "onLanguage:eql",
    "onLanguage:kuery",
    "onLanguage:lucene",
    "onLanguage:falco"
  ],
  "contributes": {
    "languages": [
      {
        "id": "opentide-yaml",
        "aliases": ["Tide YAML", "opentide-yaml"],
        "filenamePatterns": ["**/objects/**/*.yaml", "**/objects/**/*.yml"],
        "configuration": "./language-configuration/opentide-yaml.json"
      },
      {
        "id": "opentide-config",
        "aliases": ["opentide configuration", "opentide-config"],
        "filenamePatterns": ["**/.opentide/configurations/**/*.toml"],
        "configuration": "./language-configuration/opentide-config.json"
      },
      {
        "id": "kql",
        "aliases": ["KQL (Microsoft)", "kql"],
        "extensions": [".kql"],
        "configuration": "./language-configuration/kql.json"
      },
      {
        "id": "spl",
        "aliases": ["SPL", "spl"],
        "extensions": [".spl"],
        "configuration": "./language-configuration/spl.json"
      },
      {
        "id": "esql",
        "aliases": ["ES|QL", "esql"],
        "extensions": [".esql"],
        "configuration": "./language-configuration/esql.json"
      },
      {
        "id": "eql",
        "aliases": ["EQL", "eql"],
        "extensions": [".eql"],
        "configuration": "./language-configuration/eql.json"
      },
      {
        "id": "kuery",
        "aliases": ["Kibana KQL", "kuery"],
        "extensions": [".kuery"],
        "configuration": "./language-configuration/kuery.json"
      },
      {
        "id": "lucene",
        "aliases": ["Lucene", "lucene"],
        "extensions": [".lucene"],
        "configuration": "./language-configuration/lucene.json"
      },
      {
        "id": "falco",
        "aliases": ["Falco", "falco"],
        "extensions": [".falco"],
        "configuration": "./language-configuration/falco.json"
      },
      {
        "id": "cql",
        "aliases": ["CrowdStrike Query Language", "CQL", "cql"],
        "configuration": "./language-configuration/cql.json"
      },
      {
        "id": "exabeam",
        "aliases": ["Exabeam", "exabeam"],
        "configuration": "./language-configuration/exabeam.json"
      },
      {
        "id": "yara",
        "aliases": ["YARA", "yara"],
        "configuration": "./language-configuration/yara.json"
      },
      {
        "id": "yaral",
        "aliases": ["YARA-L", "yaral"],
        "configuration": "./language-configuration/yaral.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opentide",
          "title": "opentide",
          "icon": "images/activity.svg"
        }
      ]
    },
    "configurationDefaults": {
      "[opentide-yaml]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        },
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      },
      "[opentide-config]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      },
      "[kql]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[spl]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[esql]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[eql]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[kuery]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[lucene]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[falco]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      }
    },
    "configuration": [
      {
        "id": "opentide",
        "title": "opentide",
        "order": 0,
        "properties": {
          "opentide.runtime": {
            "type": "string",
            "enum": ["bundled", "installed"],
            "enumDescriptions": [
              "Run the opentide the extension carries (the default): the same version for everyone, nothing to install. Ignores an opentide on PATH or in the workspace's environment.",
              "Run your own opentide: opentide.path, the workspace's environment, uv, then PATH. If none answers, the bundled opentide runs, with a notice."
            ],
            "default": "bundled",
            "scope": "machine-overridable",
            "ignoreSync": true,
            "order": -1,
            "markdownDescription": "Which opentide runs. **bundled** (default): the module the extension carries, with no install. **installed**: your own opentide (`opentide.path`, the workspace's environment, `uv`, `PATH`); if none answers, the bundled one runs and the log says why. Setting `opentide.path` without setting this selects **installed**. A workspace's value applies only in a trusted folder; in Restricted Mode only the engine (WASM) runs, whatever this says."
          },
          "opentide.path": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "ignoreSync": true,
            "order": 0,
            "markdownDescription": "An `opentide` executable (run with `lsp start`, every feature) or an `opentide-lsp` executable (run with `--stdio`, editor features only). Setting it selects the installed opentide, unless `opentide.runtime` is set; it is tried before the other installed runtimes. Ignored in Restricted Mode."
          },
          "opentide.interpreter": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "ignoreSync": true,
            "order": 1,
            "markdownDescription": "A Python interpreter with opentide installed (`pip install opentide`). The extension runs the `opentide` script next to it, else `python -m opentide`: set this where the `opentide` command cannot run. When set, it replaces the Python extensions, `.venv` and `PATH` lookup for the workspace runtime. Ignored in Restricted Mode."
          },
          "opentide.uv.usePin": {
            "type": "boolean",
            "default": false,
            "scope": "window",
            "order": 3,
            "markdownDescription": "Run the opentide version the repository pins (`pyproject.toml`, `requirements*.txt`, `uv.lock`) with `uv tool run --from opentide==<pin>`. Tried before the workspace's environment. Ignored in Restricted Mode."
          },
          "opentide.uv.path": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "ignoreSync": true,
            "order": 4,
            "markdownDescription": "The `uv` executable for `opentide.uv.usePin`. Default: `uv` on `PATH`. Ignored in Restricted Mode."
          },
          "opentide.wasi.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "order": 2,
            "markdownDescription": "Allow the opentide module the extension carries (`opentide.runtime`: bundled) and the engine's fallback to it. It has no network of its own: the extension host makes the tenant requests (query, deploy, validate --live) for the editor and, with opentide 1.0.0-rc.3 or later, for MCP; a terminal or task has none, so use `opentide.runtime: installed` for tenant commands there. Off: your own opentide if one answers, else the editor features of the opentide engine (WASM) only. Ignored in Restricted Mode, where only the engine runs."
          },
          "opentide.envFile": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "order": 5,
            "markdownDescription": "A `.env` file, relative to the workspace folder, whose variables are passed to commands that contact a tenant (opentide reads credentials only from the environment). Ignored in Restricted Mode."
          },
          "opentide.backend.serve": {
            "type": "string",
            "enum": ["auto", "never"],
            "default": "auto",
            "scope": "window",
            "order": 6,
            "enumDescriptions": [
              "Use one warm `opentide serve` process when the runtime has it.",
              "Always spawn `opentide --json <command>`."
            ],
            "markdownDescription": "How the extension runs opentide commands."
          },
          "opentide.trace.server": {
            "type": "string",
            "enum": ["off", "messages", "verbose"],
            "default": "off",
            "scope": "window",
            "order": 7,
            "markdownDescription": "Traces the communication between VS Code and the opentide language server, in the `opentide Language Server Trace` output."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "opentide.restartServer",
        "title": "Restart Server",
        "category": "opentide",
        "icon": "$(debug-restart)"
      },
      {
        "command": "opentide.showOutput",
        "title": "Show Output",
        "category": "opentide"
      },
      {
        "command": "opentide.switchRuntime",
        "title": "Switch Runtime…",
        "category": "opentide"
      },
      {
        "command": "opentide.installOpentide",
        "title": "Install opentide…",
        "category": "opentide"
      },
      {
        "command": "opentide.statusMenu",
        "title": "Show Status Menu",
        "category": "opentide"
      },
      {
        "command": "opentide.usePinnedVersion",
        "title": "Use the Repository's Pinned Version",
        "category": "opentide"
      },
      {
        "command": "opentide.createPinnedVenv",
        "title": "Create .venv with the Pinned Version",
        "category": "opentide"
      },
      {
        "command": "opentide.showReferences",
        "title": "Show References",
        "category": "opentide"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "opentide.statusMenu",
          "when": "false"
        },
        {
          "command": "opentide.showReferences",
          "when": "false"
        },
        {
          "command": "opentide.switchRuntime",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opentide.usePinnedVersion",
          "when": "isWorkspaceTrusted && opentide.pinMismatch"
        },
        {
          "command": "opentide.createPinnedVenv",
          "when": "isWorkspaceTrusted && opentide.pinMismatch"
        }
      ]
    }
  }
}
