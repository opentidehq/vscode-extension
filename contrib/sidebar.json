    "menus": {
      "commandPalette": [
        {
          "command": "opentide.sidebar.sharePreview",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.runQuery",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.previewDeploy",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.newObjectiveForThreat",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.newRuleForObjective",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.open",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.refresh",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.validate",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.copyUuid",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.revealInExplorer",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.showInGraph",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.openMatrix",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.enablePlatform",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.openPlatformToml",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.setCredential",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.clearCredential",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.checkCredentials",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.runFix",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.copyFix",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.rerun",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.copyCommand",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.newObject",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.refreshCatalogue",
          "when": "isWorkspaceTrusted && opentide.hasCli && opentide.hasWorkspace"
        },
        {
          "command": "opentide.sidebar.refreshPlatforms",
          "when": "isWorkspaceTrusted && opentide.hasCli && opentide.hasWorkspace"
        },
        {
          "command": "opentide.sidebar.refreshHealth",
          "when": "isWorkspaceTrusted && opentide.hasCli && opentide.hasWorkspace"
        },
        {
          "command": "opentide.sidebar.checkOnline",
          "when": "isWorkspaceTrusted && opentide.hasCli && opentide.hasWorkspace"
        },
        {
          "command": "opentide.sidebar.copyReport",
          "when": "isWorkspaceTrusted && opentide.hasCli && opentide.hasWorkspace"
        },
        {
          "command": "opentide.sidebar.groupBy",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.sidebar.filter",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.sidebar.clearFilter",
          "when": "opentide.sidebar.filtered"
        },
        {
          "command": "opentide.relations.show",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.relations.open",
          "when": "false"
        },
        {
          "command": "opentide.relations.openToSide",
          "when": "false"
        },
        {
          "command": "opentide.relations.pin",
          "when": "opentide.relations.hasTarget && !opentide.relations.pinned"
        },
        {
          "command": "opentide.relations.unpin",
          "when": "opentide.relations.pinned"
        },
        {
          "command": "opentide.relations.retry",
          "when": "false"
        },
        {
          "command": "opentide.relations.back",
          "when": "opentide.relations.hasTarget"
        },
        {
          "command": "opentide.relations.forward",
          "when": "opentide.relations.hasTarget"
        }
      ],
      "view/title": [
        {
          "command": "opentide.sidebar.newObject",
          "when": "view == opentide.sidebar.catalogue && isWorkspaceTrusted && opentide.hasCli && opentide.hasWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "opentide.sidebar.refreshCatalogue",
          "when": "view == opentide.sidebar.catalogue && isWorkspaceTrusted && opentide.hasCli && opentide.hasWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "opentide.sidebar.filter",
          "when": "view == opentide.sidebar.catalogue && opentide.hasWorkspace && !opentide.sidebar.filtered",
          "group": "navigation@3"
        },
        {
          "command": "opentide.sidebar.clearFilter",
          "when": "view == opentide.sidebar.catalogue && opentide.sidebar.filtered",
          "group": "navigation@3"
        },
        {
          "command": "opentide.sidebar.groupBy",
          "when": "view == opentide.sidebar.catalogue && opentide.hasWorkspace",
          "group": "navigation@4"
        },
        {
          "command": "opentide.sidebar.openMatrix",
          "when": "view == opentide.sidebar.coverage && isWorkspaceTrusted && opentide.hasCli && opentide.hasInfoCatalog",
          "group": "navigation@1"
        },
        {
          "command": "opentide.sidebar.refreshCatalogue",
          "when": "view == opentide.sidebar.coverage && isWorkspaceTrusted && opentide.hasCli && opentide.hasWorkspace",
          "group": "navigation@2"
