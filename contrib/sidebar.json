      {
        "command": "opentide.relations.retry",
        "title": "Retry Relations",
        "category": "opentide",
        "icon": "$(refresh)"
      },
      {
        "command": "opentide.relations.back",
        "title": "Back",
        "category": "opentide",
        "icon": "$(arrow-left)",
