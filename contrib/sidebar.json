{
  "$comment": "The opentide sidebar (SPEC §9, #15).",
  "contributes": {
    "views": {
      "opentide": [
        {
          "id": "opentide.sidebar.catalogue",
          "name": "Catalogue",
          "contextualTitle": "opentide",
          "icon": "$(library)"
        },
        {
          "id": "opentide.sidebar.relations",
          "name": "Relations",
          "contextualTitle": "opentide",
          "icon": "$(references)"
        },
        {
          "id": "opentide.sidebar.coverage",
          "name": "Coverage",
          "contextualTitle": "opentide",
          "icon": "$(layers)"
        },
        {
          "id": "opentide.sidebar.platforms",
          "name": "Platforms & Tenants",
          "contextualTitle": "opentide",
          "icon": "$(server)",
          "visibility": "collapsed"
        },
        {
          "id": "opentide.sidebar.health",
          "name": "Health",
          "contextualTitle": "opentide",
          "icon": "$(heart)",
          "visibility": "collapsed"
        },
        {
          "id": "opentide.sidebar.activity",
          "name": "Activity",
          "contextualTitle": "opentide",
          "icon": "$(history)",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "opentide.sidebar.catalogue",
        "when": "workspaceFolderCount == 0",
        "contents": "Open a folder with a detection repository, or create one.\n[Open Folder](command:vscode.openFolder)\n[Create a Detection Repository…](command:opentide.setup.open)"
      },
      {
        "view": "opentide.sidebar.catalogue",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && !isWorkspaceTrusted",
        "contents": "Trust this folder to load the catalogue. In Restricted Mode only the language server runs.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "opentide.sidebar.catalogue",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.noRuntime",
        "contents": "No opentide runtime. Install opentide in the workspace's environment, or point opentide.path at one.\n[Switch Runtime…](command:opentide.switchRuntime)\n[Show Output](command:opentide.showOutput)"
      },
      {
        "view": "opentide.sidebar.catalogue",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.editorOnly",
        "contents": "This runtime runs editor features only: the catalogue needs opentide.\n[Install opentide](command:opentide.installOpentide)\n[Switch Runtime…](command:opentide.switchRuntime)"
      },
      {
        "view": "opentide.sidebar.coverage",
        "when": "workspaceFolderCount == 0",
        "contents": "Open a folder with a detection repository, or a folder to create one in.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "opentide.sidebar.coverage",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && !isWorkspaceTrusted",
        "contents": "Trust this folder to see its ATT&CK coverage.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "opentide.sidebar.coverage",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.noRuntime",
        "contents": "No opentide runtime. Install opentide in the workspace's environment, or point opentide.path at one.\n[Switch Runtime…](command:opentide.switchRuntime)\n[Show Output](command:opentide.showOutput)"
      },
      {
        "view": "opentide.sidebar.coverage",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.editorOnly",
        "contents": "This runtime runs editor features only: ATT&CK coverage needs opentide.\n[Install opentide](command:opentide.installOpentide)\n[Switch Runtime…](command:opentide.switchRuntime)"
      },
      {
        "view": "opentide.sidebar.platforms",
        "when": "workspaceFolderCount == 0",
        "contents": "Open a folder with a detection repository, or a folder to create one in.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "opentide.sidebar.platforms",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && !isWorkspaceTrusted",
        "contents": "Trust this folder to see its platforms and tenants.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "opentide.sidebar.platforms",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.noRuntime",
        "contents": "No opentide runtime. Install opentide in the workspace's environment, or point opentide.path at one.\n[Switch Runtime…](command:opentide.switchRuntime)\n[Show Output](command:opentide.showOutput)"
      },
      {
        "view": "opentide.sidebar.platforms",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.editorOnly",
        "contents": "This runtime runs editor features only: the Platforms & Tenants view needs opentide.\n[Install opentide](command:opentide.installOpentide)\n[Switch Runtime…](command:opentide.switchRuntime)"
      },
      {
        "view": "opentide.sidebar.health",
        "when": "workspaceFolderCount == 0",
        "contents": "Open a folder with a detection repository, or a folder to create one in.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "opentide.sidebar.health",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && !isWorkspaceTrusted",
        "contents": "Trust this folder to run opentide doctor.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "opentide.sidebar.health",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.noRuntime",
        "contents": "No opentide runtime. Install opentide in the workspace's environment, or point opentide.path at one.\n[Switch Runtime…](command:opentide.switchRuntime)\n[Show Output](command:opentide.showOutput)"
      },
      {
        "view": "opentide.sidebar.health",
        "when": "workspaceFolderCount > 0 && opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.editorOnly",
        "contents": "This runtime runs editor features only: opentide doctor needs opentide.\n[Install opentide](command:opentide.installOpentide)\n[Switch Runtime…](command:opentide.switchRuntime)"
      },
      {
        "view": "opentide.sidebar.coverage",
        "when": "workspaceFolderCount > 0 && !opentide.hasWorkspace && isWorkspaceTrusted && !virtualWorkspace",
        "contents": "This folder is not an opentide repository yet.\n[Set Up a Detection Repository…](command:opentide.setup.open)"
      },
      {
        "view": "opentide.sidebar.coverage",
        "when": "workspaceFolderCount > 0 && !opentide.hasWorkspace && !isWorkspaceTrusted && !virtualWorkspace",
        "contents": "This folder is not an opentide repository yet. Trust it to set one up here.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "opentide.sidebar.platforms",
        "when": "workspaceFolderCount > 0 && !opentide.hasWorkspace && isWorkspaceTrusted && !virtualWorkspace",
        "contents": "This folder is not an opentide repository yet.\n[Set Up a Detection Repository…](command:opentide.setup.open)"
      },
      {
        "view": "opentide.sidebar.platforms",
        "when": "workspaceFolderCount > 0 && !opentide.hasWorkspace && !isWorkspaceTrusted && !virtualWorkspace",
        "contents": "This folder is not an opentide repository yet. Trust it to set one up here.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "opentide.sidebar.health",
        "when": "workspaceFolderCount > 0 && !opentide.hasWorkspace && isWorkspaceTrusted && !virtualWorkspace",
        "contents": "This folder is not an opentide repository yet.\n[Set Up a Detection Repository…](command:opentide.setup.open)"
      },
      {
        "view": "opentide.sidebar.health",
        "when": "workspaceFolderCount > 0 && !opentide.hasWorkspace && !isWorkspaceTrusted && !virtualWorkspace",
        "contents": "This folder is not an opentide repository yet. Trust it to set one up here.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "opentide.sidebar.coverage",
        "when": "opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.needsCatalog",
        "contents": "Coverage needs a newer opentide: one whose `opentide info` has the `catalog` section.\n[Switch Runtime…](command:opentide.switchRuntime)"
      },
      {
        "view": "opentide.sidebar.coverage",
        "when": "opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.coverageEmpty",
        "contents": "No object names an ATT&CK technique yet. Add techniques to an objective or a rule to see what they cover.\n[New Object…](command:opentide.sidebar.newObject)"
      },
      {
        "view": "opentide.sidebar.catalogue",
        "when": "opentide.hasWorkspace && isWorkspaceTrusted && opentide.sidebar.catalogueEmpty",
        "contents": "No detections yet. Create a threat, an objective or a rule from a template.\n[New Object…](command:opentide.sidebar.newObject)"
      },
      {
        "view": "opentide.sidebar.activity",
        "contents": "No commands yet. Every opentide command the extension runs shows here, with its status and its command line, ready to copy into a terminal or CI."
      },
      {
        "view": "opentide.sidebar.catalogue",
        "when": "virtualWorkspace",
        "contents": "No threat, objective or rule in objects/ or the paths.toml object folders. In this workspace the catalogue comes from the opentide engine (WASM)'s index; new objects, coverage and deploy previews need opentide in VS Code Desktop."
      },
      {
        "view": "opentide.sidebar.coverage",
        "when": "virtualWorkspace",
        "contents": "ATT&CK coverage comes from opentide, which runs only on a local folder in VS Code Desktop. In this workspace the opentide engine (WASM) gives the editor features, the Catalogue and Relations.\n[Open a Local Folder](command:vscode.openFolder)"
      },
      {
        "view": "opentide.sidebar.platforms",
        "when": "virtualWorkspace",
        "contents": "Platforms and tenants come from opentide, which runs only on a local folder in VS Code Desktop. In this workspace the opentide engine (WASM) gives the editor features, the Catalogue and Relations.\n[Open a Local Folder](command:vscode.openFolder)"
      },
      {
        "view": "opentide.sidebar.health",
        "when": "virtualWorkspace",
        "contents": "The health checks come from opentide, which runs only on a local folder in VS Code Desktop. In this workspace the opentide engine (WASM) gives the editor features, the Catalogue and Relations.\n[Open a Local Folder](command:vscode.openFolder)"
      },
      {
        "view": "opentide.sidebar.relations",
        "when": "workspaceFolderCount == 0",
        "contents": "Open a folder with a detection repository to see how its threats, objectives and rules relate.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "opentide.sidebar.relations",
        "when": "workspaceFolderCount > 0 && !opentide.hasWorkspace && isWorkspaceTrusted && !virtualWorkspace",
        "contents": "This folder is not an opentide repository yet.\n[Set Up a Detection Repository…](command:opentide.setup.open)"
      },
      {
        "view": "opentide.sidebar.relations",
        "when": "workspaceFolderCount > 0 && !opentide.hasWorkspace && !isWorkspaceTrusted && !virtualWorkspace",
        "contents": "This folder is not an opentide repository yet. Trust it to set one up here.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "opentide.sidebar.relations",
        "when": "opentide.hasWorkspace && isWorkspaceTrusted && !virtualWorkspace",
        "contents": "Open a threat, objective or rule. This view follows the editor and shows what the object points to (→) and what points to it (←).\n[Show Relations of the Active Editor](command:opentide.relations.show)"
      },
      {
        "view": "opentide.sidebar.relations",
        "when": "opentide.hasWorkspace && !isWorkspaceTrusted && !virtualWorkspace",
        "contents": "Open a threat, objective or rule to see what it points to (→) and what points to it (←), from the language server's index. Trust this folder for the full catalogue.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "opentide.sidebar.relations",
        "when": "virtualWorkspace",
        "contents": "Open a threat, objective or rule. This view follows the editor and shows what the object points to (→) and what points to it (←), from the opentide engine (WASM)'s index.\n[Show Relations of the Active Editor](command:opentide.relations.show)"
      }
    ],
    "commands": [
      {
        "command": "opentide.sidebar.open",
        "title": "Open",
        "category": "opentide"
      },
      {
        "command": "opentide.sidebar.refresh",
        "title": "Refresh",
        "category": "opentide",
        "icon": "$(refresh)"
      },
      {
        "command": "opentide.sidebar.refreshCatalogue",
        "title": "Refresh Catalogue",
        "category": "opentide",
        "icon": "$(refresh)"
      },
      {
        "command": "opentide.sidebar.refreshPlatforms",
        "title": "Refresh Platforms",
        "category": "opentide",
        "icon": "$(refresh)"
      },
      {
        "command": "opentide.sidebar.refreshHealth",
        "title": "Run Doctor",
        "category": "opentide",
        "icon": "$(refresh)"
      },
      {
