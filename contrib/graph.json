{
  "contributes": {
    "commands": [
      {
        "command": "opentide.graph.open",
        "title": "Show Graph",
        "category": "opentide",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "opentide.graph.reveal",
        "title": "Reveal in Graph",
        "category": "opentide",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "opentide.graph.showInGraph",
        "title": "Show in Graph",
        "category": "opentide",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "opentide.graph.open",
          "when": "isWorkspaceTrusted && opentide.hasWorkspace && (opentide.hasInfoCatalog || opentide.editorOnly)"
        },
        {
          "command": "opentide.graph.reveal",
          "when": "false"
        },
        {
          "command": "opentide.graph.showInGraph",
          "when": "isWorkspaceTrusted && opentide.hasWorkspace && (opentide.hasInfoCatalog || opentide.editorOnly) && resourceLangId == opentide-yaml"
        }
      ],
      "editor/context": [
        {
          "command": "opentide.graph.showInGraph",
          "when": "isWorkspaceTrusted && opentide.hasWorkspace && (opentide.hasInfoCatalog || opentide.editorOnly) && resourceLangId == opentide-yaml",
          "group": "opentide@10"
        }
      ],
      "explorer/context": [
        {
          "command": "opentide.graph.showInGraph",
          "when": "isWorkspaceTrusted && opentide.hasWorkspace && (opentide.hasInfoCatalog || opentide.editorOnly) && resourceLangId == opentide-yaml",
          "group": "opentide@10"
        }
      ],
      "editor/title": [
        {
          "command": "opentide.graph.showInGraph",
          "when": "isWorkspaceTrusted && opentide.hasWorkspace && (opentide.hasInfoCatalog || opentide.editorOnly) && resourceLangId == opentide-yaml",
          "group": "navigation@20"
        }
      ]
    }
  }
}
