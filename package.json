    "menus": {
      "commandPalette": [
        {
          "command": "opentide.statusMenu",
          "when": "false"
        },
        {
          "command": "opentide.showReferences",
          "when": "false"
        },
        {
          "command": "opentide.switchRuntime",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opentide.usePinnedVersion",
          "when": "isWorkspaceTrusted && opentide.pinMismatch"
        },
        {
          "command": "opentide.createPinnedVenv",
          "when": "isWorkspaceTrusted && opentide.pinMismatch"
        },
        {
          "command": "opentide.setup.open",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opentide.setup.migrate",
          "when": "isWorkspaceTrusted && opentide.setup.legacyLayout"
        },
        {
          "command": "opentide.setup.agents",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opentide.setup.step",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.sharePreview",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.newObjectiveForThreat",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.newRuleForObjective",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.open",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.refresh",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.validate",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.copyUuid",
          "when": "false"
        },
        {
          "command": "opentide.sidebar.revealInExplorer",
          "when": "false"
        },
