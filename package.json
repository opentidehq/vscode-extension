{
  "name": "opentide",
  "displayName": "opentide",
  "description": "The opentide workbench for detection engineering: live checks for Tide objects and their KQL, SPL, ES|QL, EQL, Kibana KQL, Lucene and Falco queries, templates, catalogue, ATT&CK coverage, query results and deploy previews.",
  "version": "0.1.0",
  "publisher": "opentidehq",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0b213f",
    "theme": "dark"
  },
  "homepage": "https://github.com/opentidehq/vscode-extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/opentidehq/vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/opentidehq/vscode-extension/issues"
  },
  "qna": false,
  "pricing": "Free",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "AI"
  ],
  "keywords": [
    "detection engineering",
    "detection as code",
    "KQL",
    "SPL",
    "ES|QL",
    "Sentinel",
    "Defender",
    "Splunk",
    "Elastic",
    "Falco",
    "MITRE ATT&CK"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode only the language server runs, from the bundled runtime. Commands, tasks, panels, MCP and the workspace's own opentide need a trusted folder.",
      "restrictedConfigurations": [
        "opentide.path",
        "opentide.interpreter",
        "opentide.uv.usePin",
        "opentide.uv.path",
        "opentide.mcp.provide",
        "opentide.envFile",
        "opentide.terminal.addToPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "In a virtual workspace (github.dev, vscode.dev, Remote Repositories) only highlighting, languages and language configuration work: opentide reads the workspace from disk."
    }
  },
  "activationEvents": [
    "workspaceContains:.opentide/**",
    "workspaceContains:objects/**",
    "onLanguage:opentide-yaml",
    "onLanguage:opentide-config",
    "onLanguage:kql",
    "onLanguage:spl",
    "onLanguage:esql",
    "onLanguage:eql",
    "onLanguage:kuery",
    "onLanguage:lucene",
    "onLanguage:falco",
    "onMcpCollection:opentide",
    "onTaskType:opentide",
    "onTerminalProfile:opentide.terminal"
  ],
  "contributes": {
    "languages": [
      {
        "id": "opentide-yaml",
        "aliases": [
          "Tide YAML",
          "opentide-yaml"
        ],
        "filenamePatterns": [
          "**/objects/**/*.yaml",
          "**/objects/**/*.yml"
        ],
        "configuration": "./language-configuration/opentide-yaml.json"
      },
      {
        "id": "opentide-config",
        "aliases": [
          "opentide configuration",
          "opentide-config"
        ],
        "filenamePatterns": [
          "**/.opentide/configurations/**/*.toml"
        ],
        "configuration": "./language-configuration/opentide-config.json"
      },
      {
        "id": "kql",
        "aliases": [
          "KQL (Microsoft)",
          "kql"
        ],
        "extensions": [
          ".kql"
        ],
        "configuration": "./language-configuration/kql.json"
      },
      {
        "id": "spl",
        "aliases": [
          "SPL",
          "spl"
        ],
        "extensions": [
          ".spl"
        ],
        "configuration": "./language-configuration/spl.json"
      },
      {
        "id": "esql",
        "aliases": [
          "ES|QL",
          "esql"
        ],
        "extensions": [
          ".esql"
        ],
        "configuration": "./language-configuration/esql.json"
      },
      {
        "id": "eql",
        "aliases": [
          "EQL",
          "eql"
        ],
        "extensions": [
          ".eql"
        ],
        "configuration": "./language-configuration/eql.json"
      },
      {
        "id": "kuery",
        "aliases": [
          "Kibana KQL",
          "kuery"
        ],
        "extensions": [
          ".kuery"
        ],
        "configuration": "./language-configuration/kuery.json"
      },
      {
        "id": "lucene",
        "aliases": [
          "Lucene",
          "lucene"
        ],
        "extensions": [
          ".lucene"
        ],
        "configuration": "./language-configuration/lucene.json"
      },
      {
        "id": "falco",
        "aliases": [
          "Falco",
          "falco"
        ],
        "extensions": [
          ".falco"
        ],
        "configuration": "./language-configuration/falco.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opentide",
          "title": "opentide",
          "icon": "images/activity.svg"
        }
      ]
    },
    "configurationDefaults": {
      "[opentide-yaml]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        },
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      },
      "[opentide-config]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      },
      "[kql]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[spl]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[esql]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[eql]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[kuery]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[lucene]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      },
      "[falco]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.opentide": "never"
        }
      }
    },
    "configuration": [
      {
        "id": "opentide",
        "title": "opentide",
        "order": 0,
        "properties": {
          "opentide.path": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "ignoreSync": true,
            "order": 0,
            "markdownDescription": "An `opentide` executable (run with `lsp start`, every feature) or an `opentide-lsp` executable (run with `--stdio`, editor features only). Used before any other runtime. Ignored in Restricted Mode."
          },
          "opentide.interpreter": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "ignoreSync": true,
            "order": 1,
            "markdownDescription": "A Python interpreter with opentide installed. When set, it replaces the Python extensions, `.venv` and `PATH` lookup for the workspace runtime. Ignored in Restricted Mode."
          },
          "opentide.runtime": {
            "type": "string",
            "enum": [
              "auto",
              "bundled"
            ],
            "default": "auto",
            "scope": "window",
            "order": 2,
            "enumDescriptions": [
              "The first runtime that answers: `opentide.path`, the workspace's environment, uv with the repository's pin (when `opentide.uv.usePin` is on), then the bundled runtime.",
              "Always the runtime bundled with the extension."
            ],
            "markdownDescription": "Which opentide runtime the extension uses."
          },
          "opentide.uv.usePin": {
            "type": "boolean",
            "default": false,
            "scope": "window",
            "order": 3,
            "markdownDescription": "Run the opentide version the repository pins (`pyproject.toml`, `requirements*.txt`, `uv.lock`) with `uv tool run --from opentide==<pin>`. Tried before the workspace's environment. Ignored in Restricted Mode."
          },
          "opentide.uv.path": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "ignoreSync": true,
            "order": 4,
            "markdownDescription": "The `uv` executable for `opentide.uv.usePin`. Default: `uv` on `PATH`. Ignored in Restricted Mode."
          },
          "opentide.envFile": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "order": 5,
            "markdownDescription": "A `.env` file, relative to the workspace folder, whose variables are passed to commands that contact a tenant (opentide reads credentials only from the environment). Ignored in Restricted Mode."
          },
          "opentide.backend.serve": {
            "type": "string",
            "enum": [
              "auto",
              "never"
            ],
            "default": "auto",
            "scope": "window",
            "order": 6,
            "enumDescriptions": [
              "Use one warm `opentide serve` process when the runtime has it.",
              "Always spawn `opentide --json <command>`."
            ],
            "markdownDescription": "How the extension runs opentide commands."
          },
          "opentide.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "scope": "window",
            "order": 7,
            "markdownDescription": "Traces the communication between VS Code and the opentide language server, in the `opentide Language Server Trace` output."
          }
        }
      },
      {
        "id": "opentide-agents",
        "title": "opentide: Agents",
        "properties": {
          "opentide.mcp.provide": {
            "type": "string",
            "enum": [
              "auto",
              "always",
              "never"
            ],
            "default": "auto",
            "scope": "window",
            "enumDescriptions": [
              "Provide the opentide MCP server to VS Code's agents, unless the workspace's `.vscode/mcp.json` already defines `opentide`.",
              "Always provide it; VS Code shows one `opentide` server when a workspace file defines one too.",
              "Never provide it."
            ],
            "markdownDescription": "Whether the extension gives VS Code's agents the opentide MCP server (`opentide mcp start` with the resolved runtime, the bundled one included). Off in Restricted Mode, where this setting is not read."
          }
        }
      },
      {
        "id": "opentide-terminal",
        "title": "opentide: Terminal",
        "properties": {
          "opentide.terminal.addToPath": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "markdownDescription": "When the bundled runtime is active and no `opentide` is on `PATH`, put the bundled `opentide` on new integrated terminals' `PATH`. Ignored in Restricted Mode."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "opentide.restartServer",
        "title": "Restart Server",
        "category": "opentide",
        "icon": "$(debug-restart)"
      },
      {
        "command": "opentide.showOutput",
        "title": "Show Output",
        "category": "opentide"
      },
      {
        "command": "opentide.switchRuntime",
        "title": "Switch Runtime…",
        "category": "opentide"
      },
      {
        "command": "opentide.statusMenu",
        "title": "Show Status Menu",
        "category": "opentide"
      },
      {
        "command": "opentide.usePinnedVersion",
        "title": "Use the Repository's Pinned Version",
        "category": "opentide"
      },
      {
        "command": "opentide.createPinnedVenv",
        "title": "Create .venv with the Pinned Version",
        "category": "opentide"
      },
      {
        "command": "opentide.showReferences",
        "title": "Show References",
        "category": "opentide"
      },
      {
        "command": "opentide.agents.addToEditorMcp",
        "title": "Add opentide to This Editor's MCP Settings",
        "category": "opentide",
        "icon": "$(plug)"
      },
      {
        "command": "opentide.runner.run",
        "title": "Run Command…",
        "category": "opentide",
        "icon": "$(play)"
      },
      {
        "command": "opentide.runner.showLastResult",
        "title": "Show Last Command Result",
        "category": "opentide",
        "icon": "$(json)"
      },
      {
        "command": "opentide.runner.generate",
        "title": "Generate…",
        "category": "opentide",
        "icon": "$(gear)"
      },
      {
        "command": "opentide.runner.openDocs",
        "title": "Open Generated Docs",
        "category": "opentide",
        "icon": "$(book)"
      },
      {
        "command": "opentide.runner.showVocabulary",
        "title": "Show Vocabulary…",
        "category": "opentide",
        "icon": "$(symbol-enum)"
      },
      {
        "command": "opentide.runner.showUnreviewed",
        "title": "Show Unreviewed Rules",
        "category": "opentide",
        "icon": "$(history)"
      },
      {
        "command": "opentide.runner.sharePreview",
        "title": "Preview Sharing",
        "category": "opentide",
        "icon": "$(broadcast)"
      },
      {
        "command": "opentide.runner.shareStatus",
        "title": "Show Sharing Status",
        "category": "opentide",
        "icon": "$(broadcast)"
      },
      {
        "command": "opentide.runner.shareTargets",
        "title": "Show Sharing Targets",
        "category": "opentide",
        "icon": "$(broadcast)"
      },
      {
        "command": "opentide.runner.explain",
        "title": "Explain a Code…",
        "category": "opentide",
        "icon": "$(question)"
      },
      {
        "command": "opentide.runner.openTui",
        "title": "Open TUI in Terminal",
        "category": "opentide",
        "icon": "$(table)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "opentide.statusMenu",
          "when": "false"
        },
        {
          "command": "opentide.showReferences",
          "when": "false"
        },
        {
          "command": "opentide.switchRuntime",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opentide.usePinnedVersion",
          "when": "isWorkspaceTrusted && opentide.pinMismatch"
        },
        {
          "command": "opentide.createPinnedVenv",
          "when": "isWorkspaceTrusted && opentide.pinMismatch"
        },
        {
          "command": "opentide.agents.addToEditorMcp",
          "when": "isWorkspaceTrusted && opentide.agents.forkMcp"
        },
        {
          "command": "opentide.runner.showLastResult",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opentide.runner.generate",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.runner.openDocs",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.runner.showVocabulary",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.runner.showUnreviewed",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.runner.sharePreview",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.runner.shareStatus",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.runner.shareTargets",
          "when": "opentide.hasWorkspace"
        },
        {
          "command": "opentide.runner.openTui",
          "when": "opentide.hasWorkspace"
        }
      ],
      "explorer/context": [
        {
          "command": "opentide.runner.sharePreview",
          "when": "isWorkspaceTrusted && opentide.hasCli && resourceLangId == opentide-yaml",
          "group": "opentide@1"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "opentide",
        "label": "opentide"
      }
    ],
    "languageModelTools": [
      {
        "name": "opentide_open_file_diagnostics",
        "displayName": "opentide: File Diagnostics",
        "toolReferenceName": "opentideDiagnostics",
        "canBeReferencedInPrompt": true,
        "icon": "$(warning)",
        "userDescription": "The problems VS Code shows for a file: the language server's, opentide validate's and lint's.",
        "modelDescription": "Returns every diagnostic VS Code currently shows for one file, merged across the opentide language server, `opentide validate` and `opentide lint` (and other extensions), with severity, source, code, message and 1-based line/column ranges. Use it for the live state of a file the user is editing, including unsaved changes the language server has checked. Defaults to the active editor's file. For workspace-wide validation, use the opentide MCP server's tools instead.",
        "tags": [
          "opentide",
          "diagnostics"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "An absolute path, or a path relative to the first workspace folder. Omit for the active editor's file."
            }
          }
        }
      },
      {
        "name": "opentide_active_object",
        "displayName": "opentide: Active Object",
        "toolReferenceName": "opentideActiveObject",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-class)",
        "userDescription": "The Tide object in the active editor, its UUID and what it connects to.",
        "modelDescription": "Returns the opentide object (threat, objective or rule) open in the active editor: its UUID, type, schema, name, TLP, platforms, techniques and tactics, and its graph neighbourhood one hop away (the objects, signals, ATT&CK techniques and log sources it points to or that point to it, with the edge kind and field path). Use it to learn what the user is looking at. For the whole catalogue, search or validation, use the opentide MCP server's tools instead.",
        "tags": [
          "opentide",
          "catalog"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "grammars": [
      {
        "language": "eql",
        "scopeName": "source.eql",
        "path": "./syntaxes/eql.tmLanguage.json"
      },
      {
        "language": "esql",
        "scopeName": "source.opentide.esql",
        "path": "./syntaxes/esql.tmLanguage.json"
      },
      {
        "language": "falco",
        "scopeName": "source.falco",
        "path": "./syntaxes/falco.tmLanguage.json"
      },
      {
        "language": "kql",
        "scopeName": "source.kql",
        "path": "./syntaxes/kql.tmLanguage.json"
      },
      {
        "language": "kuery",
        "scopeName": "source.kuery",
        "path": "./syntaxes/kuery.tmLanguage.json"
      },
      {
        "language": "lucene",
        "scopeName": "source.lucene",
        "path": "./syntaxes/lucene.tmLanguage.json"
      },
      {
        "language": "spl",
        "scopeName": "source.spl",
        "path": "./syntaxes/spl.tmLanguage.json"
      },
      {
        "language": "opentide-yaml",
        "scopeName": "source.opentide-yaml",
        "path": "./syntaxes/tide.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.falco": "falco",
          "meta.embedded.block.kql": "kql",
          "meta.embedded.block.lucene": "lucene",
          "meta.embedded.block.spl": "spl"
        }
      },
      {
        "language": "opentide-config",
        "scopeName": "source.opentide.toml",
        "path": "./syntaxes/opentide-config.tmLanguage.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "opentide",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The opentide command path: validate, lint, generate, validate query, query, deploy (always as a dry run)…"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments after the command, such as [\"--strict\"] or [\"--platform\", \"sentinel\"]."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "opentide",
        "label": "opentide code frames",
        "owner": "opentide",
        "source": "opentide",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning|note)\\[([A-Za-z0-9_.:-]+)\\]: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*(?:╭─▶|╰─▶|-->)\\s+(.+?):(\\d+)(?::(\\d+))?\\s*$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "opentide.terminal",
          "title": "opentide",
          "icon": "terminal"
        }
      ]
    }
  },
  "scripts": {
    "features": "node scripts/features-index.mjs",
    "manifest": "node scripts/manifest.mjs",
    "manifest:check": "node scripts/manifest.mjs --check",
    "grammars": "node scripts/grammars.mjs",
    "grammars:check": "node scripts/grammars.mjs --check",
    "build": "npm run features && node scripts/build.mjs",
    "build:production": "npm run features && node scripts/build.mjs --production",
    "watch": "npm run features && node scripts/build.mjs --watch",
    "typecheck": "npm run features && tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "compile-tests": "npm run features && tsc -p tsconfig.json",
    "test": "npm run compile-tests && mocha",
    "test:integration": "npm run build && npm run compile-tests && vscode-test --label integration",
    "test:restricted": "npm run build && npm run compile-tests && vscode-test --label restricted",
    "vscode:prepublish": "npm run build:production",
    "package": "vsce package"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "mocha": "12.0.3",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  }
}
