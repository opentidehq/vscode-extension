{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/syntaxes",
      "!**/package.json",
      "!**/package-lock.json",
      "!**/src/features/index.generated.ts",
      "!**/contrib/grammars.json",
      "!**/runtime-licenses"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "error", "useConst": "error" },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "error", "options": { "allow": ["error"] } }
      }
    }
  },
  "overrides": [
    { "includes": ["scripts/**", "test/**"], "linter": { "rules": { "suspicious": { "noConsole": "off" } } } }
  ],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
